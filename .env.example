# OpenWeather AI Assistant
# https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=

# OpenAI / OpenRouter compatible endpoint
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=openai/gpt-5.2

# Optional OpenRouter ranking headers
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=

# Default prompts used by the demo scripts
OPENAI_PROMPT=What's weather like in London?
WEATHER_PROMPT=What's weather like in London?
